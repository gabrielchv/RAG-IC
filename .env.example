# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Gemini API key from https://aistudio.google.com/apikey
RAG_GEMINI_API_KEY=

# Active company corpus (maps to data/<company>/ and index/<company>/)
RAG_COMPANY=aurora
RAG_COMPANY_DISPLAY_NAME=Metalúrgica Aurora Ltda.

# Generation
RAG_LLM_PROVIDER=gemini
RAG_GEMINI_MODEL=gemini-2.5-flash
RAG_GEMINI_TEMPERATURE=0.1
# Reasoning effort: minimal | low | medium | high (deixe vazio para o padrão do modelo).
# Tokens de "thinking" são cobrados como saída. O provider mapeia este nível para o campo
# que a família do modelo aceita: thinking_level no Gemini 3, thinking_budget no Gemini
# 2.5 (minimal=0, low=512, medium=4096, high=12288). Em gemini-2.5-flash, "minimal"
# desliga o raciocínio por completo.
RAG_GEMINI_THINKING_LEVEL=low

# Retrieval
RAG_TOP_K=5
RAG_CANDIDATES_PER_RETRIEVER=30
RAG_RRF_K=60
RAG_RETRIEVAL_STRATEGY=hybrid

# Embeddings
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=auto

# Chunking
RAG_MAX_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP_RATIO=0.15

# Local LLM (only used when RAG_LLM_PROVIDER=ollama)
RAG_OLLAMA_HOST=http://localhost:11434
RAG_OLLAMA_MODEL=qwen3:4b

RAG_LOG_LEVEL=INFO
